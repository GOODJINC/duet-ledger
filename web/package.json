{
  "name": "duet-ledger-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "node scripts/check-i18n.mjs && node scripts/build-manuals.mjs",
    "docs:check": "node scripts/build-manuals.mjs --check",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:offline": "node scripts/offline-smoke.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^21.0.4",
    "marked": "18.1.1",
    "playwright": "1.62.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "license": "AGPL-3.0-only"
}
