# Published image version. Change this to update; no Git/source build required.
DUET_LEDGER_IMAGE=ghcr.io/goodjinc/duet-ledger:0.3.0
# 기본값은 서버 내부에서만 접속할 수 있습니다.
DUET_LEDGER_BIND=127.0.0.1
DUET_LEDGER_PORT=18088
# HTTPS reverse proxy: e.g. https://ledger.example.com (without trailing slash)
DUET_LEDGER_PUBLIC_URL=
DUET_LEDGER_SECURE_COOKIE=false

# Optional: exact reverse-proxy IPs/CIDRs, comma separated. Empty ignores forwarded IP headers.
DUET_LEDGER_TRUSTED_PROXIES=
